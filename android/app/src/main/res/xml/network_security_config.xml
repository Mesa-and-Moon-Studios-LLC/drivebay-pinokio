<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- DriveBay is LAN/Tailscale self-hosted; allow cleartext HTTP. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
