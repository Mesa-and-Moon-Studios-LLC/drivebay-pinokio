<?xml version="1.0" encoding="utf-8"?>
<!--
  The share banner is a real row above the browser, not a FrameLayout overlay.
  Status-bar and cutout insets pad the root, so the banner text and the WebView
  (toolbar, then file list) start below the status bar. The list scrolls inside
  the WebView, and the first row is not drawn under the banner.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1218"
    android:orientation="vertical">

    <TextView
        android:id="@+id/shareBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E3A2F"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="#BBF7D0"
        android:textSize="13sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pairedPcsBtn"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#163028"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="40dp"
        android:text="@string/phone_share_pairs"
        android:textAllCaps="false"
        android:textColor="#BBF7D0"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/tailscalePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tailscale_title"
                android:textColor="#E8EEF7"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/tailscale_help"
                android:textColor="#94A3B8"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tailscaleDownloadBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/tailscale_download" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tailscaleSkipBtn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/tailscale_skip"
                android:textColor="#E8EEF7" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/setupPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="#E8EEF7"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/app_settings_note"
                    android:textColor="#94A3B8"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/url_help"
                    android:textColor="#94A3B8"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/server_name_label"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/serverNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="#1E2533"
                    android:hint="@string/server_name_hint"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:padding="14dp"
                    android:textColor="#E8EEF7"
                    android:textColorHint="#64748B"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/url_label"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/urlInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="#1E2533"
                    android:hint="@string/server_url_hint"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:padding="14dp"
                    android:textColor="#E8EEF7"
                    android:textColorHint="#64748B"
                    android:textSize="15sp" />

                <CheckBox
                    android:id="@+id/rememberLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:buttonTint="#7DD3FC"
                    android:checked="true"
                    android:text="@string/remember_login"
                    android:textColor="#CBD5E1" />

                <CheckBox
                    android:id="@+id/wifiOnlyLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:buttonTint="#7DD3FC"
                    android:text="@string/wifi_only_large"
                    android:textColor="#CBD5E1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/connectBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/save_connect" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/downloadsBtn"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/downloads"
                    android:textColor="#E8EEF7" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/checkUpdatesBtn"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/check_for_updates"
                    android:textColor="#E8EEF7" />

                <TextView
                    android:id="@+id/serversLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/servers_label"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/serversHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/servers_hint"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/serversList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/phone_share_section"
                    android:textColor="#E8EEF7"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/phone_share_help"
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ownerPasswordBtn"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/phone_share_owner_enter"
                    android:textAllCaps="false"
                    android:textColor="#E8EEF7" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pairedPcsSettingsBtn"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/phone_share_pairs"
                    android:textAllCaps="false"
                    android:textColor="#E8EEF7" />

                <LinearLayout
                    android:id="@+id/phoneShareBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/settingsFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="@string/settings"
            android:src="@android:drawable/ic_menu_preferences"
            android:visibility="gone" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/downloadsFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="16dp"
            android:contentDescription="@string/downloads"
            android:src="@android:drawable/stat_sys_download"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
